# Pin the public registry for this repo.
#
# This machine's global config points at registry.npmmirror.com, a read-only
# mirror with no audit endpoint, which made `pnpm audit` fail with
# ERR_PNPM_AUDIT_ENDPOINT_NOT_EXISTS and left dependency advisories invisible
# locally. Setting it per-repo restores auditing and makes resolution identical
# for anyone who clones, without touching a global preference that other
# projects may rely on.
#
# Never add auth tokens here. This file is committed.
registry=https://registry.npmjs.org/
