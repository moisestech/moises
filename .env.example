# Supabase (for lead capture)
# Get these from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Calendly (optional override)
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/moisestech/15-minute-meeting

# Airtable (server-only — artist CV / exhibitions)
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=applobxXXvCQiIcNj

# LIFE OS (server-only — applications Inbox / Actions / Projects)
# Base: https://airtable.com/apprswzWnLrHBwFcx
# Discover: npm run life-os:discover
